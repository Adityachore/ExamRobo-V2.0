# Copy to server/.env for local development. Do not commit the real file.

NODE_ENV=development
DATABASE_URL=postgres://examrobo:examrobo@localhost:5450/examrobo
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-value

# Development-only first-admin bootstrap. In production use:
#   ADMIN_PASSWORD='...' npm run create-admin -- admin@example.com
ADMIN_EMAILS=
ADMIN_PASSWORD=

# Empty in production means same-origin only. Add comma-separated origins only
# when a separate browser origin must call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Safe Exam Browser (optional)
SEB_REQUIRED=false
SEB_CONFIG_KEY=
SEB_CONFIG_FILE=./assets/exam.seb
SEB_START_URL=

# Optional tuning
PORT=4000
TRUST_PROXY=1
NETWORK_GAP_SEC=45
