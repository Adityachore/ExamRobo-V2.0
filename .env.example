# ExamRobo — production environment for docker compose.
# Copy to .env, replace every placeholder, then chmod 600 .env.
# The real .env is gitignored; never commit or paste it.

NODE_ENV=production
PORT=4000
JWT_TTL=4h
JWT_SECRET=replace-with-64-hex-characters
BCRYPT_ROUNDS=12

# Applied by Postgres only when the pgdata volume is first created.
DB_PASSWORD=replace-with-a-strong-password
DB_PORT=5450
REDIS_PORT=6379
API_PORT=4000
WEB_PORT=8083

# Public origin served by Cloudflare (the SPA is same-origin through nginx).
CORS_ORIGINS=https://examrobo.pararobo.in
TRUST_PROXY=1
NETWORK_GAP_SEC=45

# Recording upload is removed. The path and volume stay for legacy cleanup only.
RECORDINGS_DIR=/data/recordings

AUTH_RATE_LIMIT=30
TICKET_RATE_LIMIT=10
WS_TICKET_RATE_LIMIT=30

# Keep SEB off until exam.seb and a 64-hex Config Key are in place.
SEB_REQUIRED=false
SEB_CONFIG_KEY=
SEB_START_URL=https://examrobo.pararobo.in
SEB_CONFIG_FILE=/app/assets/exam.seb

# Development-only first-admin bootstrap. Never set these in production.
ADMIN_EMAILS=
ADMIN_PASSWORD=
